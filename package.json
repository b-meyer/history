{
  "name": "history-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run site#dev",
    "dev:leads": "vp run site#dev:leads",
    "preview": "vp run site#preview",
    "build": "vp run -r build",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp run -r test",
    "ready": "vp check && vp run -r typecheck && vp run -r test && vp run -r build",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.3"
}
